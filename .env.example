# Copia este archivo a .env y ajusta los valores locales.
# No subas el .env real al control de versiones.

# URI preferida (SQLAlchemy). Ejemplo con driver psycopg (v3):
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://usuario:contrasena@localhost:5432/oplestaurants

# Alternativa compatible (se usa si SQLALCHEMY_DATABASE_URI no está definida):
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/oplestaurants

# Clave para firmar la cookie de sesión. En local, si falta, se genera una
# clave efímera aleatoria (las sesiones se invalidan en cada arranque). En un
# entorno persistente DEBE definirse con un valor secreto propio:
FLASK_SECRET_KEY=cambia-esta-clave-por-un-valor-secreto-largo-y-aleatorio

# Servir cookies solo por HTTPS (poner a 1 en producción con TLS):
# FLASK_SESSION_COOKIE_SECURE=1

# OpenRouter: solo se usa en el backend. No expongas estos valores al cliente.
# OPENROUTER_API_KEY=tu-clave-de-openrouter
# OPENROUTER_MODEL=proveedor/modelo
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_TIMEOUT=20
# OPENROUTER_MAX_TOKENS=1200

# Servidor de desarrollo (opcional, solo local):
# El modo debug está apagado por defecto. Para activarlo explícitamente en
# desarrollo usa `python -m flask --app app run --debug` (intérprete del venv).
# No lo uses en producción ni en redes compartidas.
# FLASK_APP=app
# FLASK_DEBUG=1
